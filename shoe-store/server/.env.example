PORT=5000
DATABASE_URL=postgres://shoestore:shoestore@localhost:5432/shoe_store
JWT_SECRET=change-this-local-secret

# Optional: enables AI-ranked product advice after backend catalog filtering.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables Gemini embeddings and grounded RAG answers from the Express backend only.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_CHAT_MODEL=gemini-2.5-flash
RAG_TOP_K=6

# VNPay credentials must stay on the backend. Use Sandbox values for local development.
VNPAY_HOST=https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=your_tmn_code
VNPAY_SECURE_SECRET=your_secure_secret
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNPAY_IPN_URL=https://your-public-backend.example/api/payments/vnpay/ipn
VNPAY_TEST_MODE=true
FRONTEND_URL=http://localhost:5173
