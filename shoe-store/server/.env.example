PORT=5000
DATABASE_URL=postgres://shoestore:shoestore@localhost:5432/shoe_store
JWT_SECRET=change-this-local-secret

# Optional: enables AI-ranked product advice after backend catalog filtering.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables Gemini embeddings and grounded RAG answers from the Express backend only.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_CHAT_MODEL=gemini-2.5-flash
RAG_TOP_K=6
